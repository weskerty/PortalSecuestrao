# Administradores, Libertad Total (tambien a terminal web)
ADMIN_USERS=user:pass
FREE_MACS=


# === Config a NO FREE_MACS ===
# Opción A: IPs fijas Permitidas (wpp puede cambiar)
WA_RANGES=31.13.64.0/18,157.240.0.0/16,179.60.192.0/22

# Opción B: dominios en vez de ip fija, si se ajusta ignorara WA_RANGES
YESDOM=whatsapp.com,whatsapp.net

# Velocidad max en KB (0 es sin limite)
SPEED=500



PORT=8080
DNS_PORT=5454
IFACE_IN=wlan2 
LOG_MAX=500



# Para evitar el "Conexion Limitada"  
CONNECTIVITY_DOMAINS=captive.apple.com,connectivitycheck.gstatic.com,www.msftconnecttest.com,www.msftncsi.com
OPEN_MS=7000 # Permite 7 Segundos de conexion abierta.
