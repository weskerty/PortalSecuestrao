# =============================================================================
#  PortalSecuestrao - configuracion
#
#  Este archivo es la plantilla. Al arrancar, si no existe .env se copia tal
#  cual, y si ya existe solo se le anaden las claves nuevas que falten: tus
#  valores no se tocan nunca, ni al actualizar.
#
#  Los comentarios al final de una linea se ignoran. Si un valor necesita
#  contener " #", ponlo entre comillas: CLAVE="algo # con almohadilla"
# =============================================================================

# --- Red ---------------------------------------------------------------------
# Vacio = autodeteccion. El nombre de la interfaz del hotspot y su subred los
# elige la ROM (no siempre es wlan1 ni 192.168.43.1), asi que lo normal es
# dejar las dos en blanco y que el portal lo averigue.
IFACE_IN=
GW=

PORT=8080
DNS_PORT=5454

# Cada cuanto se comprueba si el hotspot cambio de interfaz o de IP, en ms.
# Si cambia, las reglas se rehacen solas. 0 = no vigilar (no recomendado: un
# cambio de subred deja el DNS redirigido a una IP muerta y sin aviso).
DETECT_MS=10000

# 1 = corta IPv6 en el hotspot. El filtrado es solo IPv4: si el operador da
# IPv6 al anclaje, los clientes saldrian por v6 sin pasar por ninguna regla.
BLOCK_IPV6=1

# 1 = los clientes solo pueden hablar con internet a traves del jardin: ni
# entre ellos, ni con la red desde la que compartes, ni con otros puertos del
# telefono (solo el portal y el DNS). Ponlo a 0 si necesitas que lleguen a la
# LAN o a otro servicio del movil (por ejemplo sshd).
ISOLATE=1

# --- Panel de administracion -------------------------------------------------
# 0 = apaga el panel entero: ninguna ruta /api/*, no se sirve admin.html y no
#     se abre el WebSocket. El portal sigue igual (captura, login, filtrado) y
#     la configuracion pasa a hacerse editando este archivo.
ADMIN=1

# 0 = sin /ws/shell, que es lo que ejecuta comandos en el telefono. Por defecto
#     apagado. El panel sigue sirviendo para ver dispositivos, log y config.
ADMIN_SHELL=0

# usuario:clave,usuario2:clave2
# Si se deja vacio se genera una clave aleatoria en cada arranque y se escribe
# en el log, para que no quede nunca una clave conocida por defecto.
# El login exige ademas que la MAC este en FREE_MACS (o entrar por loopback
# desde el propio telefono), asi que un cliente cualquiera no llega al prompt.
ADMIN_USERS=

# Caducidad de la sesion del panel, en ms.
SESSION_TTL_MS=86400000

# --- Clientes ----------------------------------------------------------------
# Ventana sin filtrar justo despues de autenticar, en ms. 0 funciona y es lo
# mas estricto: el portal se sirve desde el propio telefono, asi que no hace
# falta abrir nada para que la pagina cargue. Con CLEAN_MS, cada cliente
# recibe esta ventana de internet libre una vez por ciclo de limpieza.
OPEN_MS=0

# Cada cuanto se desautentica a todos, en ms. 0 = nunca.
CLEAN_MS=3600000

# Limite por cliente en kbit/s. 0 = sin limite.
SPEED=0

# Entradas de log en memoria.
LOG_MAX=500

# MACs con acceso total: ni portal ni filtro. Son tambien las unicas que
# pueden entrar al panel.
FREE_MACS=


# =============================================================================
#  QUE SE PERMITE
#  El portal no sabe nada de ningun servicio concreto: todo sale de estas dos
#  listas. Para usarlo con otra cosa, solo se cambian estos valores.
# =============================================================================

# 1) Dominios permitidos. Se resuelven al arrancar Y se aprenden del trafico
#    DNS real de los clientes, asi la lista de IPs se mantiene al dia sola.
#    El match es por sufijo: "ejemplo.com" cubre tambien "api.ejemplo.com".
ALLOW_DOMAINS=whatsapp.net,whatsapp.com

# 2) CIDRs permitidos de forma fija. No se resuelve nada, se aceptan tal cual.
#    Estos son los e*.whatsapp.net, que viven en AWS Global Accelerator: se
#    dejan a /32 a proposito para no abrir infraestructura compartida.
ALLOW_RANGES=3.33.221.48/32,3.33.252.61/32,15.197.206.217/32,15.197.210.208/32

# (WA_RANGES y YESDOM siguen funcionando como alias de ALLOW_RANGES y
#  ALLOW_DOMAINS, por compatibilidad con configuraciones antiguas.)


# =============================================================================
#  APRENDIZAJE POR DNS
# =============================================================================

SNOOP=1
SNOOP_MAX=256

# Caducidad de cada CIDR aprendido, en ms. Sin esto la lista solo crece, se
# llena de IPs que el proveedor ya no usa y deja de aprender las nuevas.
# 0 = no caducan.
SNOOP_TTL_MS=86400000

# Re-resolver ALLOW_DOMAINS cada X ms. 0 = solo al arrancar.
SNOOP_REFRESH_MS=1800000

# Donde se guarda lo aprendido entre reinicios. "" = no guardar.
SNOOP_CACHE=.snoop.json

# 1 = los dispositivos ya autenticados siguen pasando por el DNS propio, lo que
#     permite aprender tambien de SU trafico (no solo del previo al login).
# 0 = tras autenticar, su DNS va directo al resolver.
SNOOP_FORCE_DNS=0

# SNOOP_WIDEN: en que redes es seguro AGRUPAR las IPs aprendidas, y a que
# prefijo. Fuera de las redes listadas se usa /32.
#
#   Por que existe: un CDN con balanceo geografico devuelve IPs distintas segun
#   el momento y segun el resolver, asi que un /32 se queda obsoleto enseguida.
#   Pero ensanchar a ciegas es peligroso: si el destino es infraestructura
#   compartida (AWS Global Accelerator, Cloudflare, etc.), un /24 arrastra miles
#   de servicios ajenos y el jardin vallado deja de servir.
#
#   Meta sirve WhatsApp, Instagram y Facebook desde los MISMOS /23, partidos en
#   dos mitades: el /24 par (.102, .206) va a Facebook/Instagram y el impar
#   (.103, .207) a WhatsApp. Por eso el widen es a /24 y no a /23: con /23
#   entrarian las tres aplicaciones.
#
#   Formato: red/mascara:prefijo_destino,...
SNOOP_WIDEN=57.144.0.0/14:24

# Resolvers propios, separados por comas. Vacio = 1.1.1.1, 8.8.8.8, 9.9.9.9.
# Se consultan los tres en paralelo y gana el que responde antes.
RESOLVERS=

# --- Deteccion de portal cautivo --------------------------------------------
# Dominios que el sistema operativo consulta para decidir si "hay internet".
CONNECTIVITY_DOMAINS=captive.apple.com,connectivitycheck.gstatic.com,www.msftconnecttest.com,www.msftncsi.com

# 1 = esos dominios entran en la allowlist. Sin esto, un cliente ya autenticado
#     no alcanza el servidor de comprobacion, el movil sigue diciendo "iniciar
#     sesion en la red" y Android puede volverse solo a datos moviles. Cuesta
#     unas pocas IPs de Apple/Google, a /32 y sin agrupar.
CONN_ALLOW=1


# =============================================================================
#  OTROS EJEMPLOS
# =============================================================================
#
# --- Solo Telegram -----------------------------------------------------------
#   ALLOW_DOMAINS=telegram.org,t.me,telegram.me,cdn-telegram.org
#   ALLOW_RANGES=
#   SNOOP_WIDEN=
#
#   Telegram publica sus propios rangos y son bastante estables, asi que con los
#   dominios y los /32 aprendidos suele bastar.
#
# --- Solo correo e intranet corporativa -------------------------------------
#   ALLOW_DOMAINS=miempresa.com,outlook.office365.com,login.microsoftonline.com
#   SNOOP_FORCE_DNS=1
#   SNOOP_WIDEN=
#
#
# =============================================================================
#  COMO AVERIGUAR LOS RANGOS DE UN SERVICIO NUEVO
# =============================================================================
#
#  1) Resuelve el dominio contra VARIOS resolvers: cada uno te devuelve el PoP
#     mas cercano a el, no el conjunto completo.
#       nslookup <dominio> 1.1.1.1
#       nslookup <dominio> 8.8.8.8
#       nslookup <dominio> 9.9.9.9
#
#  2) Mira de quien es cada IP y cual es el prefijo que anuncia, con el servicio
#     IP-to-ASN de Team Cymru. Se invierten los octetos de la IP:
#       1.2.3.4  ->  nslookup -type=TXT 4.3.2.1.origin.asn.cymru.com 1.1.1.1
#     Devuelve: ASN | prefijo | pais | registro | fecha
#
#  3) Decide el widen con eso: si el prefijo pertenece en exclusiva al servicio,
#     se puede agrupar; si es un CDN o un acelerador compartido, dejalo en /32.
#
#  4) Y la fuente definitiva es el propio portal: mira el log, que escribe cada
#     CIDR que aprende y de que consulta salio.
#
#
# =============================================================================
#  LIMITES QUE CONVIENE SABER
# =============================================================================
#
#  - Las notificaciones push NO van por los dominios de la app: APNs de Apple
#    usa 17.0.0.0/8 puerto 5223 y FCM de Google mtalk.google.com puertos
#    5228-5230. Las reglas son por destino, sin filtro de puerto, asi que
#    permitirlas implica abrir el rango entero de esos proveedores.
#
#  - Si un invitado tiene el DNS privado de Android en modo estricto, su DNS no
#    pasa por este portal y se queda sin resolver nada. El portal le corta el
#    853 al instante para que el sistema vuelva al DNS normal, pero en algunos
#    moviles hay que apagarlo a mano.
#
#  - El filtro es por MAC: cambiar la MAC lo evita. Para el uso previsto
#    (compartir con amigos sin gastar los datos) sobra, pero no es un control
#    de acceso.
