# =============================================================================
#  PortalSecuestrao - configuracion de ejemplo
#  Copia este archivo a .env y ajusta los valores.
# =============================================================================

# --- Red ---------------------------------------------------------------------
IFACE_IN=wlan2            # interfaz del hotspot ("ip addr" para verla)
# GW=192.168.43.1         # opcional: por defecto se autodetecta de IFACE_IN
PORT=8080                 # puerto del portal HTTP
DNS_PORT=5454             # puerto del DNS propio (al que se hace DNAT el 53)

# --- Panel de administracion -------------------------------------------------
# 0 = apaga el panel entero: ninguna ruta /api/*, no se sirve admin.html y no
#     se abre el WebSocket. El portal sigue funcionando igual (captura, login
#     de clientes, filtrado); la configuracion pasa a hacerse editando este
#     archivo y reiniciando el proceso.
ADMIN=1

# 0 = mantiene el panel de monitorizacion pero quita /ws/shell, que es lo unico
#     que ejecuta comandos arbitrarios en el telefono. Recomendado en cualquier
#     despliegue publico: /api/env y /api/stop ya permiten administrar sin
#     necesidad de una shell.
ADMIN_SHELL=1

# usuario:clave,usuario2:clave2
# CAMBIALO: si se deja vacio, el codigo cae al default "admin:1234".
# Solo aplica con ADMIN=1. El login exige ademas que la MAC del cliente este en
# FREE_MACS, asi que un usuario cualquiera del hotspot no llega ni al prompt.
ADMIN_USERS=admin:cambia-esta-clave

# --- Clientes ----------------------------------------------------------------
OPEN_MS=7000              # ventana sin filtrar justo despues de autenticar (ms)
CLEAN_MS=3600000          # cada cuanto se desautentica a todos (ms)
SPEED=0                   # limite por cliente en kbit/s (0 = sin limite)
LOG_MAX=500               # entradas de log en memoria
FREE_MACS=                # MACs con acceso total: ni portal ni filtro


# =============================================================================
#  QUE SE PERMITE
#  El portal no sabe nada de ningun servicio concreto: todo sale de estas dos
#  listas. Para usarlo con otra cosa, solo se cambian estos valores.
# =============================================================================

# 1) CIDRs permitidos de forma fija. No se resuelve nada, se aceptan tal cual.
ALLOW_RANGES=

# 2) Dominios permitidos. Se resuelven al arrancar Y se aprenden del trafico
#    DNS real de los clientes, asi la lista de IPs se mantiene al dia sola.
#    El match es por sufijo: "ejemplo.com" cubre tambien "api.ejemplo.com".
ALLOW_DOMAINS=

# (WA_RANGES y YESDOM siguen funcionando como alias de ALLOW_RANGES y
#  ALLOW_DOMAINS, por compatibilidad con configuraciones antiguas.)


# =============================================================================
#  APRENDIZAJE POR DNS
# =============================================================================

SNOOP=1                   # 0 = desactivado (solo se usa ALLOW_RANGES)
SNOOP_MAX=256             # tope de CIDRs aprendidos, para no inflar iptables
SNOOP_REFRESH_MS=1800000  # re-resolver ALLOW_DOMAINS cada X ms (0 = solo al arrancar)
SNOOP_CACHE=.snoop.json   # persistir lo aprendido entre reinicios ("" = no)

# 1 = los dispositivos ya autenticados siguen pasando por el DNS propio, lo que
#     permite aprender tambien de SU trafico (no solo del previo al login).
# 0 = comportamiento clasico: tras autenticar, su DNS va directo al resolver.
SNOOP_FORCE_DNS=0

# SNOOP_WIDEN: en que redes es seguro AGRUPAR las IPs aprendidas, y a que
# prefijo. Fuera de las redes listadas se usa /32.
#
#   Por que existe: un CDN con balanceo geografico devuelve IPs distintas segun
#   el momento y segun el resolver, asi que un /32 se queda obsoleto enseguida.
#   Pero ensanchar a ciegas es peligroso: si el destino es infraestructura
#   compartida (AWS Global Accelerator, Cloudflare, etc.), un /24 arrastra miles
#   de servicios ajenos y el jardin vallado deja de servir. Con esto se decide
#   red por red.
#
#   Formato: red/mascara:prefijo_destino,...
SNOOP_WIDEN=

# --- Deteccion de portal cautivo --------------------------------------------
# Dominios que el sistema operativo consulta para decidir si "hay internet".
# Se reenvian de verdad para que salte la pantalla de login. Las rutas
# /generate_204, /hotspot-detect.html y similares ya las responde el portal.
CONNECTIVITY_DOMAINS=captive.apple.com,connectivitycheck.gstatic.com,www.msftconnecttest.com,www.msftncsi.com


# =============================================================================
#  EJEMPLOS
# =============================================================================
#
# --- Solo WhatsApp -----------------------------------------------------------
#   ALLOW_DOMAINS=whatsapp.net,whatsapp.com
#   SNOOP_WIDEN=57.144.0.0/14:24
#   ALLOW_RANGES=3.33.221.48/32,3.33.252.61/32,15.197.206.217/32,15.197.210.208/32
#
#   Meta sirve WhatsApp, Instagram y Facebook desde los MISMOS /23, partidos en
#   dos mitades: el /24 par (.102, .206) va a Facebook/Instagram y el impar
#   (.103, .207) a WhatsApp. Por eso el widen es a /24 y no a /23: con /23
#   entrarian las tres aplicaciones.
#   Los /32 de ALLOW_RANGES son los e*.whatsapp.net, que viven en AWS Global
#   Accelerator; se dejan a /32 a proposito para no abrir infraestructura ajena.
#
#   Nota: las notificaciones push NO van por dominios de WhatsApp (APNs de Apple
#   en 17.0.0.0/8 puerto 5223; FCM de Google via mtalk.google.com puertos
#   5228-5230). Las reglas de la allowlist son por destino, sin filtro de
#   puerto, asi que permitirlas implica abrir el rango entero de esos proveedores.
#
# --- Solo Telegram -----------------------------------------------------------
#   ALLOW_DOMAINS=telegram.org,t.me,telegram.me,cdn-telegram.org
#   SNOOP_WIDEN=
#
#   Telegram publica sus propios rangos y son bastante estables, asi que con los
#   dominios y /32 aprendidos suele bastar. Si quieres fijarlos, consulta los
#   prefijos actuales de su AS en vez de copiar una lista vieja.
#
# --- Solo correo e intranet corporativa -------------------------------------
#   ALLOW_DOMAINS=miempresa.com,outlook.office365.com,login.microsoftonline.com
#   SNOOP_FORCE_DNS=1
#   SNOOP_WIDEN=
#
#
# =============================================================================
#  COMO AVERIGUAR LOS RANGOS DE UN SERVICIO NUEVO
# =============================================================================
#
#  1) Resuelve el dominio contra VARIOS resolvers: cada uno te devuelve el PoP
#     mas cercano a el, no el conjunto completo.
#       nslookup <dominio> 1.1.1.1
#       nslookup <dominio> 8.8.8.8
#       nslookup <dominio> 9.9.9.9
#
#  2) Mira de quien es cada IP y cual es el prefijo que anuncia, con el servicio
#     IP-to-ASN de Team Cymru. Se invierten los octetos de la IP:
#       1.2.3.4  ->  nslookup -type=TXT 4.3.2.1.origin.asn.cymru.com 1.1.1.1
#     Devuelve: ASN | prefijo | pais | registro | fecha
#
#  3) Decide el widen con eso: si el prefijo pertenece en exclusiva al servicio,
#     se puede agrupar; si es un CDN o un acelerador compartido, dejalo en /32.
#
#  4) Y la fuente definitiva es el propio portal: arranca con SNOOP=1 y mira el
#     log, que escribe cada CIDR que aprende y de que consulta salio.
